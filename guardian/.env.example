# Red: testnet (por defecto) o previewnet. El guardián de MAINNET (beta) va aparte, con su propio guardian/.env.mainnet
# (lo crea «hvault-vps mainnet preparar», con clave nueva y los topes obligatorios).
HEDERA_NETWORK=testnet

# Cuenta del guardián: paga las llamadas al notario (unos céntimos de HBAR cada una) y puede vetar.
# Puedes usar la misma clave del .env de hedera-vault-poc.
OPERATOR_KEY=
# Con clave ECDSA se puede dejar vacío.
OPERATOR_ID=

# Escucha solo en local: la app llega a través del servidor de Expo (ruta /guardian) o, con la app compilada,
# por https://guardian.h10xindex.xyz (Caddy en este mismo servidor; ver «hvault-aislar guardian-publico»).
HOST=127.0.0.1
PORT=8787
POLL_SECONDS=10

# Topes diarios, por bóveda, de las llamadas al notario que paga el guardián (completar, bloquear y
# congelar). Sin tope, cualquiera con una bóveda propia podría dejarlo sin saldo. Para mainnet: 10, 10 y 4.
# BUDGET_APPROVES_DAY=100
# BUDGET_VETOES_DAY=100
# BUDGET_FREEZES_DAY=30

# Saldo del guardián (HBAR): por debajo de MIN_BALANCE_HBAR avisa (en su registro, en /info y, si está
# puesto, en ADMIN_NTFY_URL); por debajo de RESERVE_HBAR solo bloquea, no completa.
# MIN_BALANCE_HBAR=10
# RESERVE_HBAR=2
# Opcional: tema de ntfy donde avisar a quien administra el guardián.
# ADMIN_NTFY_URL=https://ntfy.sh/un-tema-largo-y-secreto

# Avisos por correo a los dueños (los ponen ellos en la app, con su kit). Servicio: brevo, resend o
# postmark (o «archivo» para probar: escribe los correos en data/correos.jsonl y no manda nada).
# El remitente tiene que estar verificado en el servicio (SPF y DKIM en el DNS del dominio).
# EMAIL_PROVIDER=brevo
# EMAIL_API_KEY=
# EMAIL_FROM=avisos@h10xindex.xyz
# EMAIL_FROM_NAME=H10X Wallet
# Tope de correos por bóveda y día (que nadie llene el buzón de nadie).
# EMAIL_PER_DAY=30

# Tokens con llave de comisiones que el guardián SÍ completa solo (separados por comas). Los demás con
# esa llave esperan a que el dueño los complete desde la app: su emisor podría ponerles una comisión
# justo en el último segundo y la pagaría la bóveda.
# TRUSTED_FEE_KEY_TOKENS=0.0.1234,0.0.5678

# Opcional: cuenta que cobra las comisiones del servicio (la misma que EXPO_PUBLIC_FEE_COLLECTOR de la
# app). Solo sirve para que los avisos digan "comisión" en vez de "y 2 HBAR a 0.0.x".
# FEE_COLLECTOR=0.0.1234

# Opcional: clave de la API de SaucerSwap (se pide a support@saucerswap.finance). Con ella la app
# muestra también el valor en € y $ de los tokens. Se queda en el VPS: nunca va dentro de la app.
# SAUCERSWAP_API_KEY=

# Topes de la beta (0 = sin tope). Con MAX_VAULT_HBAR, la app no deja guardar más de esos HBAR en cada bóveda
# y el guardián avisa al dueño (una vez al día) si pasa de ahí. MAX_VAULTS: bóvedas que vigila como mucho.
# Para la beta en mainnet, por ejemplo: MAX_VAULT_HBAR=1000 y MAX_VAULTS=50. Para probarlo en testnet: MAX_VAULT_HBAR=200.
# MAX_VAULT_HBAR=0
# MAX_VAULTS=500
# CAP_CHECK_SECONDS=1800

# Avisos de H10X (DAO y cambios de cesta): el guardián lee el mirror PÚBLICO de mainnet (solo lectura, sin usar su
# clave) y avisa por push, sin correo, a las bóvedas que los quieran (lo eligen en la app y va firmado). Encendidos por
# defecto; H10X_ALERTS=0 los apaga.
# H10X_ALERTS=1
# H10X_POLL_SECONDS=120
# H10X_MIRROR_URL=https://mainnet-public.mirrornode.hedera.com

# Aviso de emergencia para todas las bóvedas: no va aquí. Se pone y se quita con «hvault-vps aviso» (como root),
# que escribe data/aviso.json; el guardián lo manda una vez a todas por push (y por correo si es «evacuar»).
