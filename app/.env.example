# Red de Hedera para la app.
EXPO_PUBLIC_HEDERA_NETWORK=testnet

# Opcional: dirección pública del guardián. Si se deja vacía, la app usa el propio servidor de Expo
# del VPS (ruta /guardian), que reenvía al guardián local. Es lo recomendable en la fase 1.
# EXPO_PUBLIC_GUARDIAN_URL=https://guardian.tudominio.com

# Comisiones del servicio: preparadas pero APAGADAS. Se activan poniendo la cuenta que cobra.
# Por defecto: 2 HBAR al guardar en la bóveda y 2 HBAR al sacar (solo si la retirada sale).
# Nunca se cobran en recuperaciones con el kit, evacuaciones ni ajustes.
# EXPO_PUBLIC_FEE_COLLECTOR=0.0.1234
# EXPO_PUBLIC_DEPOSIT_FEE_HBAR=2
# EXPO_PUBLIC_WITHDRAW_FEE_HBAR=2

# WalletConnect: exigir que el dominio de la dApp esté verificado (1) o permitirlo con aviso (0).
# Por defecto: sí en mainnet, no en testnet. Las conexiones desde el navegador de la app siempre valen.
# EXPO_PUBLIC_REQUIRE_VERIFIED_DOMAIN=1
